{
  "name": "idmc-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run sitemap && vite build && npm run check:size && npm run ping",
    "deploy": "npm run build && wrangler deploy && npm run ping",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "check:size": "tsx scripts/check-bundle-size.ts",
    "ping": "tsx scripts/ping-indexing.ts",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile tests/e2e",
    "test:a11y": "playwright test --project=chromium-desktop tests/e2e/a11y.spec.ts",
    "test:visual": "playwright test --project=chromium-desktop --project=chromium-mobile tests/visual",
    "test:report": "playwright show-report playwright-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "storybook": "^8.6.18",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.2"
  }
}
